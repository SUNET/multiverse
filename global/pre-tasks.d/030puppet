#!/bin/sh
#
# Re-used example from SJD
#

set -e

stamp="$COSMOS_BASE/stamps/puppet-tools-v01.stamp"

. /etc/os-release
if [ "$ID" = almalinux ]; then
	test "${VERSION_ID%%.*}" = 10
	dir="$COSMOS_MODEL/pre-tasks.d/openvox"
	install -C -m 0644 "$dir/GPG-KEY-openvox.pub" /etc/pki/rpm-gpg/GPG-KEY-openvox.pub
	install -C -m 0644 "$dir/openvox8.repo" /etc/yum.repos.d/multiverse-openvox8.repo
	if ! test -x /opt/puppetlabs/bin/puppet || ! test -f "$stamp"; then
		dnf -y install 'openvox-agent-8.*' python3-pyyaml openssl cronie tar
		mkdir -p "$(dirname "$stamp")"
		touch "$stamp"
	fi
	exit 0
fi
if ! test -f "${stamp}" -a -f /usr/bin/puppet; then
	apt-get update
	apt-get -y install puppet
	apt-get -y install python3-debian
	# shellcheck source=/dev/null
	. /etc/os-release

	# Note: in posix shell, string comparison is done with a single =
	if [ "${ID}" = "debian" ] && [ "${VERSION_ID}" -ge 12 ] || ([ "${ID}" = "ubuntu" ] && dpkg --compare-versions "${VERSION_ID}" ge 24.04); then
		apt-get -y install \
			cron \
			puppet-module-camptocamp-augeas \
			puppet-module-puppetlabs-apt \
			puppet-module-puppetlabs-concat \
			puppet-module-puppetlabs-cron-core \
			puppet-module-puppetlabs-stdlib \
			puppet-module-puppetlabs-vcsrepo

	fi

	mkdir -p "$(dirname "${stamp}")"
	touch "${stamp}"
fi
