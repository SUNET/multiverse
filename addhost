#!/bin/bash

cmd_hostname=""
cmd_mode=""
cmd_fqdn=""

function usage() {
	echo "Usage: $0 [-h] [-b | -r] [-p jump-host] [-n fqdn] [--] [<host>]"
	echo "  -h  show help"
	echo "  -b  bootstrap <host> over SSH (default)"
	echo "  -r  register <host> in Git for later bootstrap"
	echo "  -p  SSH jump host"
	echo "  -n  specify FQDN (if not the same as <host>)"
	echo ""
	echo "  <host> can be an IP number, or something that resolves to one"
}

while getopts "brhn:p:" this; do
	case "${this}" in
	h)
		usage
		exit 0
		;;
	b | r)
		if [[ -n $cmd_mode && $cmd_mode != "$this" ]]; then
			usage >&2
			exit 1
		fi
		cmd_mode=$this
		;;
	n) cmd_fqdn="${OPTARG}" ;;
	p) cmd_proxy="${OPTARG}" ;;
	*)
		echo "Unknown option ${this}"
		echo ""
		usage
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))

if [[ ! $cmd_hostname ]]; then
	cmd_hostname="$1"
fi

if [[ ! $cmd_fqdn ]]; then
	cmd_fqdn="$cmd_hostname"
fi

if test -z "$cmd_hostname"; then
	usage
	exit 1
fi

# shellcheck source=/dev/null
test -f cosmos.conf && . ./cosmos.conf

_remote=${remote:='ro'}
defrepo=$(git remote get-url "${_remote}" 2>/dev/null)
rrepo=${repo:="$defrepo"}
rtag=${tag:="changeme"}

if [[ ! $rrepo ]]; then
	echo "$0: repo not set in cosmos.conf and no git remote named '${_remote}' found"
	exit 1
fi

if [ ! -d "$cmd_fqdn" ]; then
	cp -prv default "$cmd_fqdn" || exit 1
	git add "$cmd_fqdn" || exit 1
	git --no-pager diff --staged
	echo
	echo -e "\e[1mONLY COMMIT IF YOU APPROVE THE DIFF ABOVE\e[0m"
	git commit -vm "$cmd_fqdn added" "$cmd_fqdn" || exit 1
	./bump-tag || exit 1
fi

if [[ ${cmd_mode:-b} == b ]]; then
	exec scripts/bootstrap-host "$cmd_hostname" "$cmd_fqdn" "$rrepo" "$rtag" "" "${cmd_proxy:-}"
fi
